generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Grade {
  id      String           @id @default(cuid())
  name    String           @unique
  classes Class[]
  tasks   CollectionTask[]
  students User[]
}

model Class {
  id       String @id @default(cuid())
  name     String
  gradeId  String
  grade    Grade  @relation(fields: [gradeId], references: [id])
  students User[]

  @@unique([gradeId, name])
}

model User {
  id                 String           @id @default(cuid())
  username           String           @unique
  passwordHash       String
  mustChangePassword Boolean          @default(false)
  name               String
  studentNumber      String?          @unique
  role               String           @default("STUDENT")
  isSuperAdmin       Boolean          @default(false)
  isClassOfficer     Boolean          @default(false)
  isStudentOfficer   Boolean          @default(false)
  classId            String?
  class              Class?           @relation(fields: [classId], references: [id])
  gradeId            String?
  grade              Grade?           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  sessions           Session[]
  submissions        Submission[]
  tasks              CollectionTask[]
  attachments        Attachment[]
  managedTasks       TaskManager[]
  submissionRequests SubmissionRequest[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model CollectionTask {
  id             String       @id @default(cuid())
  title          String
  description    String
  status         String       @default("DRAFT")
  deadline       DateTime
  allowEdit      Boolean      @default(true)
  officerCanView Boolean      @default(false)
  gradeId        String
  grade          Grade        @relation(fields: [gradeId], references: [id])
  creatorId      String
  creator        User         @relation(fields: [creatorId], references: [id])
  createdAt      DateTime     @default(now())
  fields         FormField[]
  targets        TaskTarget[]
  submissions    Submission[]
  attachments    Attachment[]
  managers       TaskManager[]
  submissionRequests SubmissionRequest[]
}

model SubmissionRequest {
  taskId String
  userId String
  key String
  requestHash String
  receipt String
  createdAt DateTime @default(now())
  task CollectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId, key])
  @@index([createdAt])
}

model TaskManager {
  taskId String
  userId String
  task CollectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskTarget {
  taskId String
  userId String
  task   CollectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model FormField {
  id       String             @id @default(cuid())
  taskId   String
  task     CollectionTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label    String
  type     String
  required Boolean            @default(false)
  options  String             @default("[]")
  position Int
  answers  SubmissionAnswer[]
  attachments Attachment[]
}

model Submission {
  id          String             @id @default(cuid())
  taskId      String
  task        CollectionTask     @relation(fields: [taskId], references: [id])
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  submittedAt DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  answers     SubmissionAnswer[]

  @@unique([taskId, userId])
}

model SubmissionAnswer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  field        FormField  @relation(fields: [fieldId], references: [id])
  value        String

  @@unique([submissionId, fieldId])
}

model Attachment {
  id        String @id @default(cuid())
  taskId    String
  task      CollectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldId   String
  field     FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([taskId, userId])
}
